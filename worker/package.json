{
  "name": "nchat-worker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 execute nchat-db --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute nchat-db --remote --file=./migrations/0001_init.sql",
    "db:migrate:local:0002": "wrangler d1 execute nchat-db --local --file=./migrations/0002_privacy_extra.sql",
    "db:migrate:remote:0002": "wrangler d1 execute nchat-db --remote --file=./migrations/0002_privacy_extra.sql",
    "tail": "wrangler tail",
    "test": "vitest run && vitest run --config vitest.realtime.config.ts"
  },
  "dependencies": {
    "hono": "^4.13.20"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.0",
    "@cloudflare/workers-types": "^5.20261121.1",
    "typescript": "^5.7.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "wrangler": "^4.166.0"
  }
}
