<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only: allow plain HTTP so a developer can point Settings ▸ Server at a local
  `cargo run` backend (http://10.0.2.2:8080 or http://192.168.x.x:8080). Release builds keep
  Android's default — HTTPS only — because the shipped backend is an HTTPS address supplied
  at build time (see nchat.properties).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application android:usesCleartextTraffic="true" />

</manifest>
